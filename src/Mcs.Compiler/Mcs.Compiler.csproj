<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mcs</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- MC# language version (Language in Versions.cs) -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/mcdata.json" LogicalName="mcdata.json" />
    <!-- the simulator ships with the compiler for `mcs run` -->
    <None Include="../../tools/mcsim.py" Link="tools/mcsim.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
