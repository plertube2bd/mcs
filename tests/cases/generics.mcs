// Generic methods and classes: one copy per type argument.
using System.Numerics;

static T Max<T>(T a, T b) where T : INumber<T> => a > b ? a : b;

static T Sum3<T>(T a, T b, T c) where T : INumber<T> {
    T s = T.Zero;
    s += a; s += b; s += c;
    return s;
}

class Box<T> where T : INumber<T> {
    public T Value;
    public Box(T v) { Value = v; }
    public T Twice() => Value + Value;
    public void Set(T v) { Value = v; }
}

class Pair<A, B> {
    public A First;
    public B Second;
}

public static void Main() {
    m.Console.WriteLine($"max int={Max(3, 9)} milli={Max(1.5f, -2f)} q16={Max<Q16>(0.25, 0.125)}");
    m.Console.WriteLine($"sum={Sum3(1, 2, 3)} sumf={Sum3(0.5f, 0.25f, 1f)}");
    var bi = new Box<int>(21);
    var bf = new Box<Milli>(1.25f);
    bi.Set(bi.Twice());
    m.Console.WriteLine($"bi={bi.Value} bf={bf.Twice()}");
    var p = new Pair<int, bool> { First = 5, Second = true };
    m.Console.WriteLine($"pair={p.First},{p.Second}");
}
