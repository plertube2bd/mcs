// float is ×1000 fixed point, double is Q15.16 (×65536).
static Q16 sx = 1.25;
static Q16 v = -2.75;

public static void Main() {
    Q16 a = sx;
    Q16 b = a * a;
    Q16 c = b / 3;
    Q16 d = a / b;
    Milli f = 2.5f;
    Q16 mixed = f * a;
    Milli back = (Milli)(a * 2);
    int whole = (int)(b * 10);
    m.Console.WriteLine($"b={b} c={c} d={d} mixed={mixed} back={back} whole={whole}");

    Q16 x = v;
    x++;
    Q16 p = x * -3.5;
    Q16 q = -7 / x;
    int three = 3;
    Q16 r = three * 0.1;
    m.Console.WriteLine($"x={x} p={p} q={q} r={r} big={p > 6.1249}");

    Q16 big = 30000;
    Q16 sat = big / 0.001;               // does not fit: saturates
    m.Console.WriteLine($"sat={sat} small={1 / big}");
}
